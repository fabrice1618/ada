# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=plateforme
MYSQL_USER=plateforme_user
MYSQL_PASSWORD=changeme_user

# --- Django ---
DJANGO_SECRET_KEY=changeme_secret_key
DEBUG=0

# Derriere le proxy HTTPS d'argos : 1.
# Acces HTTP direct, sans proxy : 0.
SESSION_COOKIE_SECURE=1

# --- Domaine (ALLOWED_HOSTS et CSRF) ---
# Poste local, une fois le proxy branché : ada.localhost
# VPS de test : ada.mips.science
DOMAIN=ada.localhost

# --- Depots de fichiers ---
UPLOAD_ROOT=/uploads
ALLOWED_EXTENSIONS=pdf,zip,tar.gz,py,java,c,cpp,txt
MAX_UPLOAD_SIZE_MB=10
# Rendu en plusieurs fichiers : nombre maximal par rendu
MAX_UPLOAD_FILES=10
